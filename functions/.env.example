# ===== MYKOSOVA FUNCTIONS — CONFGURIMI (vetëm për zhvillim lokal) =====
# NE PRODHIM: këto vlera SË vendosen këtu — por me:
#   firebase functions:secrets:set PADDLE_API_KEY
#   firebase functions:secrets:set PADDLE_WEBHOOK_SECRET
#   firebase functions:secrets:set PADDLE_PRICE_GOLD
#   firebase functions:secrets:set PADDLE_PRICE_PREMIUM
#   firebase functions:secrets:set GOOGLE_PLACES_API_KEY
# (vlerat mbeten te Firebase Secrets — kurrë në repo)

PROVIDER=paddle
PADDLE_TEST_MODE=true
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_GOLD=
PADDLE_PRICE_PREMIUM=

# ===== IMPORTUESI MASIV (Bulk Importer — Google Places → Firestore) =====
# Kërkohet nga: callable-i 'importoMasiv' dhe CLI-ja scripts/importo-masiv.js
# Çelësi duhet të ketë të aktivizuar "Places API (New)".
# Për CLI-në përdoret si variabël ambienti, JO ky skedar:
#   export GOOGLE_PLACES_API_KEY=AIza...
#   export GOOGLE_APPLICATION_CREDENTIALS=/rruga/te/service-account.json
GOOGLE_PLACES_API_KEY=
